FROM apache/airflow:2.10.5-python3.12

USER root

# git is required, not incidental: src/gitops/values_writer.py shells out to it
# to clone, commit and push the deployed model version, which is how the
# retraining pipeline deploys a shadow and how asie_auto_rollback reverts a bad
# primary. Under GitOps the commit IS the deploy, so without git in this image
# the pipeline can train, register and export a model and then silently fail to
# deploy any of it. ssh is already present in the base image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

COPY requirements/requirements_airflow.txt /requirements_airflow.txt

# torch is CPU-only here too — separate layer/index, same reasoning as the
# serving dockerfile (see that file's comment).
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.6.0
RUN pip install --no-cache-dir -r /requirements_airflow.txt

ENV PYTHONPATH=/opt/airflow/asie
WORKDIR /opt/airflow/asie

COPY --chown=airflow:root src/ ./src/
COPY --chown=airflow:root configs/ ./configs/
COPY --chown=airflow:root pyproject.toml .
# DVC scaffolding, not the data. .dvc/config names the S3 remote and
# data/*.dvc are the pointers `dvc pull` resolves against it -- without both,
# the retraining DAG's dvc_pull task has nothing to work with and the pipeline
# dies on a missing ./data/financial_phrasebank.parquet.
#
# Exact paths, no globs. `COPY data/*.dvc` makes BuildKit walk the tree to
# resolve the wildcard, which reaches .venv/lib64 -- a WSL symlink Windows
# cannot stat -- and fails the build with
#   "error from sender: open .venv\lib64: The file cannot be accessed"
# even though .venv/ is in the dockerignore.
COPY --chown=airflow:root .dvc/config ./.dvc/config
COPY --chown=airflow:root data/financial_phrasebank.parquet.dvc ./data/

# DVC refuses to run outside an SCM repo ("/opt/airflow/asie is not a git
# repository", exit 255) and .git is deliberately not in the image. no_scm
# tells DVC to operate on the working tree alone, which is all `dvc pull`
# needs given the pointer file is present.
#
# Written to config.local rather than config: config.local is gitignored and
# image-only, so the checked-in .dvc/config keeps working normally on a dev
# machine, where the repo genuinely is under git.
RUN printf '[core]\n    no_scm = true\n' > ./.dvc/config.local
COPY --chown=airflow:root airflow-home/dags/ /opt/airflow/dags/
