# Per-Dockerfile override for `docker build -f Dockerfile.airflow`.
# BuildKit uses this file INSTEAD OF .dockerignore when it exists (not
# merged) — so the exclusions the serving build needs (airflow-home/,
# dags/) are deliberately absent here, since this build needs to COPY them.

# Git and editor noise
.git/
.vscode/
.idea/

# Python / local env
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# MLflow, training outputs, and local models — not needed baked into the
# image; the retraining pipeline writes exported_model/ then syncs it to
# S3 itself (see src/models/export_model.py), it doesn't need a stale copy
# already present in the image.
artifacts/
runs/
mlruns/
mlflow/
model/
exported_model/

# Data: keep manifests and DVC pointers only — the DAG runs `dvc pull`
data/*
!data/data_manifest.yaml
# The parquet itself stays out of the image (it comes from the DVC remote at
# run time), but the .dvc pointer must be in, or `dvc pull` has nothing to
# resolve. Same for .dvc/config, which names the S3 remote.
#
# Exact path, NOT `!data/*.dvc`. A wildcard negation defeats BuildKit's
# directory-pruning optimisation and makes it walk into every excluded
# directory -- including .venv/, whose lib64 is a WSL symlink Windows cannot
# stat, which fails the build with
#   "error from sender: open .venv\lib64: The file cannot be accessed"
!data/financial_phrasebank.parquet.dvc
!data/*.dvc

# Stale duplicate airflow dir (airflow-home/ is the active one, kept)
airflow/
temp_airflow_run.txt

# Secrets and local databases
.env
.env.*
*.pem
*.pem.pub
*.db
*.sqlite
*.sqlite3

# Terraform local state and cache
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*tfplan*
plan-outputs/
