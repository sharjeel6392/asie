# Local environments
.venv/
venv/
env/

# Python caches and packaging outputs
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Runtime outputs
artifacts/
logs/
mlruns/
runs/
mlflow.db
*.db
*.sqlite
*.sqlite3
*.log
temp_airflow_run.txt

# Data and model artifacts
# These use `dir/**` + `!dir/**/` rather than a bare `dir/`. Git never
# descends into an ignored *directory*, so under `data/` the negations
# below could never match -- which hid data/*.dvc from DVC's collector
# (it honors gitignore), leaving `dvc status` reporting "no data tracked"
# and `dvc push` exiting 0 having pushed nothing.
data/**
model/**
exported_model/**
!data/**/
!model/**/
!exported_model/**/
!**/*.dvc
!data/data_manifest.yaml
!model/model_registry.yaml

# Local orchestration state
airflow/
airflow-home/
eks/tmp-cluster.yaml

# Secrets and local env files
/.env
/.env.*
!/.env.example
*.pem
*.pem.pub

# Terraform local state and cache
.terraform/
**/.terraform/
.terraform.lock.hcl
**/.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
**/terraform.tfstate
**/terraform.tfstate.backup
*.tfplan
*tfplan*
asie-plan.tfplan
plan-outputs/

# Local editor files
.vscode/
.idea/
.helmignore

# Legacy stray package output
src/UNKNOW*
