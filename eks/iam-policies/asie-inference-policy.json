{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadModels",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::asie-platform-818111885210/models/*"
    },
    {
      "Sid": "ListModelsPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::asie-platform-818111885210",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["models/*"]
        }
      }
    }
  ]
}
