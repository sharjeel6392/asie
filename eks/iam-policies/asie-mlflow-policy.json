{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteMlflowArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::asie-platform-818111885210/mlflow-artifacts/*"
    },
    {
      "Sid": "ListMlflowArtifactsPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::asie-platform-818111885210",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["mlflow-artifacts/*"]
        }
      }
    },
    {
      "Sid": "BucketLocation",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::asie-platform-818111885210"
    }
  ]
}
