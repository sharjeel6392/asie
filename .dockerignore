# Git and editor noise
.git/
.vscode/
.idea/

# Python / local env
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# MLflow, training outputs, and local models
artifacts/
runs/
mlruns/
mlflow/
model/
exported_model/

# Data: keep manifests and DVC pointers only
data/*
!data/data_manifest.yaml
!data/*.dvc

# Logs and local orchestration state
# NOTE: /pipelines/ is anchored (leading slash) so it only matches a
# top-level pipelines/ dir, not src/pipelines/ — an unanchored "pipelines/"
# here previously matched src/pipelines/ too (gitignore-style matching is
# depth-unaware without a leading slash), silently dropping it from every
# build context even though `COPY src/ ./src/` looks like it should copy it.
logs/
/pipelines/
airflow/
airflow-home/
dags/
temp_airflow_run.txt

# Secrets and local databases
.env
.env.*
*.pem
*.pem.pub
*.db
*.sqlite
*.sqlite3

# Terraform local state and cache
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*tfplan*
plan-outputs/
